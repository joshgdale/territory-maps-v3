{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./*"],
      "@generated/*": ["../.adonisjs/client/*"],
      "#middleware/*": ["../app/middleware/*.js"],
      "#transformers/*": ["../app/transformers/*.js"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../.adonisjs/client/**/*.ts",
    "../.adonisjs/server/pages.d.ts"
  ]
}
