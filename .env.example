# Node
TZ=UTC
PORT=3333
# Bind all interfaces (required in Docker / Coolify)
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
# Public origin (use https://your-domain on Coolify — share links & cookies depend on this)
APP_URL=http://localhost:${PORT}

# Session
SESSION_DRIVER=cookie

# Rate limiter (memory for single container; database for multi-replica Coolify)
LIMITER_STORE=memory

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=territory-maps-v3

# Drive / DigitalOcean Spaces
DRIVE_DISK=spaces
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=lon1
SPACES_BUCKET=
SPACES_ENDPOINT=https://${SPACES_REGION}.digitaloceanspaces.com

# PDF / Gotenberg
# Local: http://localhost:3000 — Coolify: http://<gotenberg-service>:3000
GOTENBERG_URL=http://localhost:3000
GOTENBERG_API_BASIC_AUTH_USERNAME=
GOTENBERG_API_BASIC_AUTH_PASSWORD=
GOTENBERG_SECRET=
