# Node
TZ=UTC
PORT=3333
# Bind 0.0.0.0 so Docker Gotenberg can callback via host.docker.internal
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=territory-maps-v3

# Drive / DigitalOcean Spaces
DRIVE_DISK=spaces
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=lon1
SPACES_BUCKET=
SPACES_ENDPOINT=https://${SPACES_REGION}.digitaloceanspaces.com

# PDF / Gotenberg
GOTENBERG_URL=http://localhost:3000
GOTENBERG_API_BASIC_AUTH_USERNAME=
GOTENBERG_API_BASIC_AUTH_PASSWORD=
GOTENBERG_SECRET=
